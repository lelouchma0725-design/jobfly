# ── Supabase ──────────────────────────────────────────────
# Project URL（https://xxxx.supabase.co）
SUPABASE_URL=
# service_role key（後端使用，繞過 RLS，務必保密，切勿暴露給前端）
SUPABASE_SERVICE_ROLE_KEY=
# 直連 Postgres（Alembic 遷移用，Supabase Dashboard → Database → Connection string）
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ── 加密（信封加密的 KEK，32 字節 base64；生成：openssl rand -base64 32）──
KEK_BASE64=

# ── 對象存儲（Cloudflare R2，附件直傳）─────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jobfly-documents
R2_PUBLIC_BASE_URL=

# ── LLM（OpenAI 兼容 API，可切換 DeepSeek/OpenAI 等）───────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_STRUCTURED_MODEL=deepseek-chat

# ── 推送渠道（服務端默認配置；用戶可覆蓋）──────────────────
WECOM_WEBHOOK_URL=
# SMTP 兜底渠道
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── 瀏覽器自動化（P3/P4）────────────────────────────────────
# Playwright 瀏覽器安裝路徑（本地開發指向工作區內路徑，避免寫系統目錄）
PLAYWRIGHT_BROWSERS_PATH=

# ── 運行 ──────────────────────────────────────────────────
APP_ENV=dev
# 前端地址（CORS）
FRONTEND_URL=http://localhost:5173
# 對外訪問基址（生成 H5 回填連結用）
PUBLIC_BASE_URL=http://localhost:8000
